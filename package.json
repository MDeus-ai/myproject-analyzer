{
  "name": "myproject-analyzer",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@myproject/web",
    "build": "npm run build --workspace=@myproject/web",
    "preview": "npm run preview --workspace=@myproject/web",
    "test": "npm run test --workspace=@myproject/core",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18"
  }
}
