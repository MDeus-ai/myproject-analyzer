{
  "name": "@myproject/rust-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build:rust": "cargo build --release --features napi-binding",
    "build:wasm": "wasm-pack build --target web --out-dir ../../apps/web/public/wasm -- --features wasm-binding",
